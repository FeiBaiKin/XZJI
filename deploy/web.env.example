# 前台（Nuxt）环境变量样例。
# systemd 用 Environment= 逐条设置（见 deploy/systemd/xzji-web.service），
# 面板的“Node 项目”用它自己的环境变量界面逐条填，值都与这份样例一致。
# NUXT_ 前缀的变量由 Nuxt 自动映射到 nuxt.config.ts 里的 runtimeConfig，改名前先看那里。

# 监听地址和端口，由 Nginx 反向代理过来
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# 服务端渲染时调用接口的地址。单机部署保持 127.0.0.1；分机部署改成后端服务器的内网地址
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8080/api/v1

# 浏览器直连的接口地址，用 api 域名，必须是 https
NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1

# 站点对外地址，用于 canonical、og:url 和 sitemap，末尾不要带 /
NUXT_PUBLIC_SITE_URL=https://www.example.com

# 站点名称，显示在页面标题和页脚
NUXT_PUBLIC_SITE_NAME=XZJI

# 清空页面缓存的密钥，必须与后端 config.yaml 里的 frontend.purge_secret 完全一致
# 生成：openssl rand -hex 32
NUXT_PURGE_SECRET=请替换为随机密钥
