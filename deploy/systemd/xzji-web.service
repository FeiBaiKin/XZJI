# 前台服务：放到 /etc/systemd/system/，然后 systemctl enable --now xzji-web
[Unit]
Description=XZJI 前台服务（Nuxt）
After=network.target

[Service]
Type=simple
User=xzji
Group=xzji
WorkingDirectory=/opt/xzji/web
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# 服务端渲染调用接口的地址；分机部署时改成后端服务器内网地址
Environment=NUXT_API_INTERNAL_BASE=http://127.0.0.1:8080/api/v1
# 浏览器直连的接口地址
Environment=NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
# 站点对外地址，用于 canonical、og:url 和 sitemap，末尾不带 /
Environment=NUXT_PUBLIC_SITE_URL=https://www.example.com
# 后端清空缓存的密钥，必须与后端 config.yaml 的 frontend.purge_secret 一致
Environment=NUXT_PURGE_SECRET=请替换为随机密钥
ExecStart=/usr/bin/node /opt/xzji/web/.output/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
