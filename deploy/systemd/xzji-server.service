# 后端服务：放到 /etc/systemd/system/，然后 systemctl enable --now xzji-server
[Unit]
Description=XZJI 后端服务
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=xzji
Group=xzji
WorkingDirectory=/opt/xzji/server
ExecStart=/opt/xzji/server/xzji serve -c /opt/xzji/server/config.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
